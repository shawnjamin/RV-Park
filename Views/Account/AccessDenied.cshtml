@{
    ViewData["Title"] = "Access Denied";
    // Uses the public layout since they might not be an admin
    Layout = "_Layout"; 
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3">Access Denied</h1>
            <p class="lead text-muted mb-4">
                You do not have permission to view this directory or page using the credentials that you supplied.
            </p>
            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 gap-3">
                    Return to Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">
                    Sign In with Different Account
                </a>
            </div>
        </div>
    </div>
</div>