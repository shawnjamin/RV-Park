@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

@model User

@* Page container *@
<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-lg">
            
            @* Card header *@
            <div class="card-header bg-dark text-white text-center py-3">
                <h3 class="mb-0 fw-bold">Create an Account</h3>
            </div>

            @* Form body *@
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="RegisterSubmit" method="post">
                    @* Validation summary *@
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @* Name inputs row *@
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="FirstName" type="text" class="form-control" placeholder="Enter your first name" required />
                                <label>First name</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="LastName" type="text" class="form-control" placeholder="Enter your last name" required />
                                <label>Last name</label>
                            </div>
                        </div>
                    </div>

                    @* Contact inputs row *@
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                                <label>Email address</label>
                            </div>
                            @* Email uniqueness error *@
                            @if (ViewData["EmailAlreadyExists"] is true)
                            {
                                <div class="text-danger small mt-1 ps-1 fw-bold">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewData["ErrorMessage"]
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Phone" type="tel" class="form-control" placeholder="(555) 555-5555" required />
                                <label>Phone number</label>
                            </div>
                        </div>
                    </div>

                    @* Password inputs row *@
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="form-floating mb-3 mb-md-0">
                                <input for="Password" type="password" name="password" class="form-control" id="inputPassword" placeholder="Create a password" required />
                                <label>Password</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input for="ConfirmPassword" type="password" name="confirmPassword" class="form-control" id="inputPasswordConfirm" placeholder="Confirm password" required />
                                <label>Confirm Password</label>
                            </div>
                        </div>
                        @* Password match error *@
                        @if (ViewData["PasswordMatch"] is false)
                        {
                            <div class="col-12">
                                <div class="text-danger small mt-1 ps-1 fw-bold text-end">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> @ViewData["ErrorMessage"]
                                </div>
                            </div>
                        }
                    </div>

                    @* Submit button *@
                    <div class="d-grid gap-2 mt-4 mb-0">
                        <button type="submit" class="btn btn-primary btn-lg">Create Account</button>
                    </div>
                    
                </form>
            </div>

            @* Card footer *@
            <div class="card-footer text-center py-3">
                <div class="small">
                    <a asp-action="Login">Have an account? Go to login</a>
                </div>
            </div>
            
        </div>
    </div>
</div>