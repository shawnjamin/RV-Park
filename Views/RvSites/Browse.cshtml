@model IEnumerable<RVPark.Models.Site>

@{
    ViewData["Title"] = "Available Sites";
    Layout = "_Layout";
}

@* Search criteria header *@
<div class="bg-light p-4 rounded-3 shadow-sm mb-4 mt-3">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1">Available Campsites</h2>
        </div>
    </div>
</div>

@* Date Selection *@
<div class="bg-light p-4 rounded-3 shadow-sm mb-4 m-3">
    <form asp-controller="RvSites" asp-action="Browse" method="get">
        <div class="row g-3 align-items-end">
                    
            <div class="col-md-3">
                <label class="form-label fw-bold">Check-In</label>
                <input type="date"
                    id="checkIn"
                    name="checkIn"
                    class="form-control"
                    min="@DateTime.Now.ToString("yyyy-MM-dd")"
                    value="@Context.Request.Query["checkIn"]" />
            </div>
                    
            <div class="col-md-3">
                <label class="form-label fw-bold">Check-Out</label>
                <input type="date"
                    id="checkOut"
                    name="checkOut" 
                    class="form-control"
                    min="@DateTime.Now.ToString("yyyy-MM-dd")"
                    value="@Context.Request.Query["checkOut"]" />
            </div>
                    
            <div class="col-md-3">
                <label class="form-label fw-bold">Site Type</label>
                <select name="siteType" class="form-select">
                    <option value="">Any Type</option>
                    <option value="Standard">Standard</option>
                    <option value="Premium">Premium</option>
                    <option value="Pull-Through">Pull-Through</option>
                    <option value="Tent">Tent</option>
                </select>
            </div>
                    
            <div class="col-md-2">
                <label class="form-label fw-bold">RV Length (ft)</label>
                <input type="number"
                    name="rvLength"
                    class="form-control"
                    placeholder="e.g. 30"
                    value="@Context.Request.Query["rvLength"]" />
            </div>
                    
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
                    
        </div>
    </form>
</div>

@* Results grid *@
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    
    @* Check if there are any results *@
    @if (Model != null && Model.Any())
    {
        foreach (var site in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    
                    @* Site image placeholder *@
                    <img src="~/images/sites/placeholder.jpg" class="card-img-top" alt="Site @site.SiteNumber" style="height: 200px; object-fit: cover;">
                    
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold mb-0">Site @site.SiteNumber</h5>
                            <span class="badge bg-success">Available</span>
                        </div>
                        
                        <p class="text-muted small mb-3">@site.SiteType?.Name</p>
                        
                        <ul class="list-unstyled small mb-3">
                            <li class="mb-1"><i class="fa-solid fa-ruler-combined text-secondary me-2"></i>Size: @site.SizeSqft sq ft</li>
                            <li class="mb-1"><i class="fa-solid fa-plug text-secondary me-2"></i>Hookups: @site.HookupType</li>
                        </ul>
                    </div>
                    
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center p-3">
                        <div>
                            <span class="fs-5 fw-bold text-primary">$@site.SiteType?.Price</span><span class="small text-muted">/night</span>
                        </div>
                        <a asp-controller="Reservations" asp-action="Create" asp-route-site="@site" asp-route-checkIn="@Context.Request.Query["checkIn"]" asp-route-checkOut="@Context.Request.Query["checkOut"]" class="btn btn-primary">Book Now</a>
                    </div>
                    
                </div>
            </div>
        }
    }
    else
    {
        @* Empty state *@
        <div class="col-12 text-center py-5">
            <i class="fa-regular fa-face-frown fs-1 text-muted mb-3"></i>
            <h3>No sites available</h3>
            <p class="text-muted">We couldn't find any sites matching your dates. Please try adjusting your search criteria.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.book-now-btn').forEach(button => {
            button.addEventListener('click', function () {
                const siteId = this.dataset.siteId;
                const checkIn = document.getElementById('checkIn').value;
                const checkOut = document.getElementById('checkOut').value;

                if (!checkIn || !checkOut) {
                    alert('Please select both a check-in and check-out date before booking.');
                    return;
                }

                const url =
                    `/Reservations/Create?siteId=${siteId}` +
                    `&checkIn=${encodeURIComponent(checkIn)}` +
                    `&checkOut=${encodeURIComponent(checkOut)}`;

                window.location.href = url;
            });
        });
    </script>
}