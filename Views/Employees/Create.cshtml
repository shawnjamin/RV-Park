@model RVPark.Models.User

@{
    ViewData["Title"] = "Create Employee";
}

<div class="mb-4">
    <h2>Create Employee Account</h2>
    <p class="text-muted">Add a new employee account for the admin system.</p>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                        <input asp-for="FirstName" class="form-control" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                        <input asp-for="LastName" class="form-control" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccessLevel" class="form-label fw-bold">Role / Access Level</label>
                        <select asp-for="AccessLevel" class="form-select" asp-items="ViewBag.AccessLevels"></select>
                        <span asp-validation-for="AccessLevel" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsLocked" class="form-check-input" />
                        <label asp-for="IsLocked" class="form-check-label">
                            Lock this employee account immediately
                        </label>
                    </div>

                    <hr class="mb-4" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Create Employee</button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}