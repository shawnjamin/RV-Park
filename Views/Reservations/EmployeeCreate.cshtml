@model RVPark.Models.EmployeeReservationFormViewModel

@{
    ViewData["Title"] = "Walk-In Reservation";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Walk-In Reservation</h2>
        <p class="text-muted">
            Process a new reservation and manual payment for an in-person guest.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

<form asp-controller="Reservations"
      asp-action="EmployeeCreate"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="row g-4">

        <!-- Customer and trip information -->
        <div class="col-lg-8">

            <!-- Customer selection -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        1. Customer Information
                    </h5>
                </div>

                <div class="card-body p-4">
                    <label asp-for="CustomerId"
                           class="form-label fw-bold"></label>

                    <select asp-for="CustomerId"
                            asp-items="ViewBag.Customers"
                            class="form-select">
                        <option value="">
                            -- Select an Existing Customer --
                        </option>
                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger"></span>
                </div>
            </div>

            <!-- Trip details -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">
                        2. Trip Details
                    </h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="StartDate"
                                   class="form-label fw-bold"></label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="StartDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate"
                                   class="form-label fw-bold"></label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                            <span asp-validation-for="EndDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="SiteId"
                                   class="form-label fw-bold"></label>

                            <select asp-for="SiteId"
                                    asp-items="ViewBag.Sites"
                                    class="form-select">
                                <option value="">
                                    -- Select an Available Site --
                                </option>
                            </select>

                            <span asp-validation-for="SiteId"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="AdultCount"
                                   class="form-label"></label>

                            <input asp-for="AdultCount"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="AdultCount"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="ChildCount"
                                   class="form-label"></label>

                            <input asp-for="ChildCount"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="ChildCount"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="PetCount"
                                   class="form-label"></label>

                            <input asp-for="PetCount"
                                   type="number"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="PetCount"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="SpecialRequestsOrNotes"
                                   class="form-label"></label>

                            <textarea asp-for="SpecialRequestsOrNotes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Optional requests or reservation notes..."></textarea>

                            <span asp-validation-for="SpecialRequestsOrNotes"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Payment information -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        3. Payment
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-info">
                        The total will be calculated from the selected site
                        and reservation dates when the form is submitted.
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod"
                               class="form-label fw-bold"></label>

                        <select asp-for="PaymentMethod"
                                asp-items="ViewBag.PaymentMethods"
                                class="form-select border-primary">
                            <option value="">
                                -- Select Payment Method --
                            </option>
                        </select>

                        <span asp-validation-for="PaymentMethod"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentNotes"
                               class="form-label"></label>

                        <textarea asp-for="PaymentNotes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Check number, terminal reference, or other notes..."></textarea>

                        <span asp-validation-for="PaymentNotes"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-success btn-lg w-100">
                        Process and Book
                    </button>
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}