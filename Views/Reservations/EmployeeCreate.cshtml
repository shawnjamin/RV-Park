@model RVPark.Models.EmployeeReservationFormViewModel

@{
    ViewData["Title"] = "Walk-In Reservation";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Walk-In Reservation</h2>
        <p class="text-muted">
            Process a new reservation and manual payment for an in-person guest.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

<form asp-controller="Reservations"
      asp-action="EmployeeCreate"
      method="post">

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
            class="alert alert-danger"
            role="alert">
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <div class="row g-4">

        <!-- Customer and trip information -->
        <div class="col-lg-8">

            <!-- Customer selection -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">1. Customer Information</h5>
                </div>

                <div class="card-body p-4">
                    <div class="mb-4">
                        <label asp-for="CustomerId"
                            class="form-label fw-bold"></label>

                        <select asp-for="CustomerId"
                                asp-items="ViewBag.Customers"
                                class="form-select">
                            <option value="">
                                -- New Walk-In Customer --
                            </option>
                        </select>

                        <span asp-validation-for="CustomerId"
                            class="text-danger"></span>

                        <div class="form-text">
                            Select an existing customer, or leave this blank and enter
                            the walk-in customer's information below.
                        </div>
                    </div>

                    <div class="border-top pt-4">
                        <h6 class="fw-bold mb-3">New Walk-In Customer</h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NewCustomerFirstName"
                                    class="form-label"></label>

                                <input asp-for="NewCustomerFirstName"
                                    class="form-control" />

                                <span asp-validation-for="NewCustomerFirstName"
                                    class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NewCustomerLastName"
                                    class="form-label"></label>

                                <input asp-for="NewCustomerLastName"
                                    class="form-control" />

                                <span asp-validation-for="NewCustomerLastName"
                                    class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NewCustomerEmail"
                                    class="form-label"></label>

                                <input asp-for="NewCustomerEmail"
                                    type="email"
                                    class="form-control" />

                                <span asp-validation-for="NewCustomerEmail"
                                    class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NewCustomerPhone"
                                    class="form-label"></label>

                                <input asp-for="NewCustomerPhone"
                                    type="tel"
                                    class="form-control" />

                                <span asp-validation-for="NewCustomerPhone"
                                    class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
        <!-- Reservation Details -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">2. Reservation Details</h5>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">

                    @* Site selection *@
                    <div class="col-md-12">
                        <label asp-for="SiteId" class="form-label fw-bold"></label>

                        <select asp-for="SiteId"
                                asp-items="ViewBag.Sites"
                                class="form-select">
                            <option value="">-- Select a Site --</option>
                        </select>

                        <span asp-validation-for="SiteId"
                            class="text-danger"></span>
                    </div>

                    @* Check-in date *@
                    <div class="col-md-6">
                        <label asp-for="StartDate"
                            class="form-label fw-bold"></label>

                        <input asp-for="StartDate"
                            type="date"
                            class="form-control" />

                        <span asp-validation-for="StartDate"
                            class="text-danger"></span>
                    </div>

                    @* Check-out date *@
                    <div class="col-md-6">
                        <label asp-for="EndDate"
                            class="form-label fw-bold"></label>

                        <input asp-for="EndDate"
                            type="date"
                            class="form-control" />

                        <span asp-validation-for="EndDate"
                            class="text-danger"></span>
                    </div>

                    @* Guest counts *@
                    <div class="col-md-4">
                        <label asp-for="AdultCount"
                            class="form-label fw-bold"></label>

                        <input asp-for="AdultCount"
                            type="number"
                            min="1"
                            class="form-control" />

                        <span asp-validation-for="AdultCount"
                            class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ChildCount"
                            class="form-label fw-bold"></label>

                        <input asp-for="ChildCount"
                            type="number"
                            min="0"
                            class="form-control" />

                        <span asp-validation-for="ChildCount"
                            class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PetCount"
                            class="form-label fw-bold"></label>

                        <input asp-for="PetCount"
                            type="number"
                            min="0"
                            class="form-control" />

                        <span asp-validation-for="PetCount"
                            class="text-danger"></span>
                    </div>

                    @* Optional reservation notes *@
                    <div class="col-md-12">
                        <label asp-for="SpecialRequestsOrNotes"
                            class="form-label fw-bold"></label>

                        <textarea asp-for="SpecialRequestsOrNotes"
                                class="form-control"
                                rows="3"
                                placeholder="Accessibility needs, arrival notes, or other requests..."></textarea>

                        <span asp-validation-for="SpecialRequestsOrNotes"
                            class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payment information -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        3. Payment
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-info">
                        The total will be calculated from the selected site
                        and reservation dates when the form is submitted.
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentMethod"
                               class="form-label fw-bold"></label>

                        <select asp-for="PaymentMethod"
                                asp-items="ViewBag.PaymentMethods"
                                class="form-select border-primary">
                            <option value="">
                                -- Select Payment Method --
                            </option>
                        </select>

                        <span asp-validation-for="PaymentMethod"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PaymentNotes"
                               class="form-label"></label>

                        <textarea asp-for="PaymentNotes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Check number, terminal reference, or other notes..."></textarea>

                        <span asp-validation-for="PaymentNotes"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-success btn-lg w-100">
                        Process and Book
                    </button>
                </div>
            </div>
        </div>

    </div>
</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}