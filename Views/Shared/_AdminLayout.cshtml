@functions {
    @* Overload for 1 parameter (Controller only) *@
    public string IsActive(string controller)
    {
        return IsActive(controller, null);
    }

    @* Overload for 2 parameters (Controller and Action) *@
    public string IsActive(string controller, string? action)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool isControllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

        if (string.IsNullOrEmpty(action))
        {
            return isControllerMatch ? "active" : "";
        }

        bool isActionMatch = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return (isControllerMatch && isActionMatch) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RVPark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RVPark.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        /* Override ASP.NET Core's default 60px body margin */
        body {
            margin-bottom: 0 !important;
            overflow-x: hidden; /* Prevents horizontal scrolling from Bootstrap rows */
        }
    </style>
</head>
<body>

@* Mobile Header Bar with Collapsible Hamburger Toggle *@
<header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-2 shadow d-md-none">
    <a class="navbar-brand me-0 px-2 fw-bold fs-5" asp-controller="Dashboard" asp-action="Index">Admin Portal</a>
    <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
</header>

<div class="container-fluid">
    @* FIX 1: Moved min-vh-100 to the Row wrapper so columns stretch equally *@
    <div class="row min-vh-100">

        @* Sidebar Navigation *@
        <nav id="sidebarMenu" class="col-md-3 col-xl-2 d-md-block bg-dark sidebar collapse">
            <div class="position-sticky pt-3 d-flex flex-column h-100">

                @* Desktop Portal Title Header *@
                <div class="px-3 pb-3 mb-md-0 me-md-auto text-white d-none d-md-block">
                    <a asp-controller="Dashboard" asp-action="Index" class="text-white text-decoration-none">
                        <span class="fs-4 fw-bold">Admin Portal</span>
                    </a>
                </div>

                <ul class="nav nav-pills flex-column mb-auto w-100" style="list-style: none; padding-left: 0;">

                    @* Dashboard - Available to Staff & Admin *@
                    <li class="nav-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link sidebar-link @IsActive("Dashboard", "Index")">
                            <i class="fs-4 bi-house me-2"></i> <span>Dashboard</span>
                        </a>
                    </li>

                    @* Admin & Manager Only: Park Management Section *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li class="nav-item mt-3 mb-1">
                            <span class="text-secondary small fw-bold text-uppercase px-3" style="font-size: 0.75rem;">Park Management</span>
                        </li>

                        <li>
                            <a asp-controller="RvSites" asp-action="Index" class="nav-link sidebar-link @IsActive("RvSites", "Index")">
                                <i class="fs-4 bi-geo-alt me-2"></i> <span>Manage Sites</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Pricing" asp-action="Index" class="nav-link sidebar-link @IsActive("Pricing", "Index")">
                                <i class="fs-4 bi-tags me-2"></i> <span>Maintain Pricing</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Fees" asp-action="Index" class="nav-link sidebar-link @IsActive("Fees", "Index")">
                                <i class="fs-4 bi-cash-coin me-2"></i> <span>Manage Fees</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Employees" asp-action="Index" class="nav-link sidebar-link @IsActive("Employees", "Index")">
                                <i class="fs-4 bi-people me-2"></i> <span>Employee Accounts</span>
                            </a>
                        </li>
                    }

                    @* Bookings Section - Available to Staff & Admin *@
                    <li class="nav-item mt-3 mb-1">
                        <span class="text-secondary small fw-bold text-uppercase px-3" style="font-size: 0.75rem;">Bookings</span>
                    </li>

                    <li>
                        <a asp-controller="Reservations" asp-action="Index" class="nav-link sidebar-link @IsActive("Reservations", "Index")">
                            <i class="fs-4 bi-calendar-check me-2"></i> <span>Manage Reservations</span>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Reservations" asp-action="EmployeeCreate" class="nav-link sidebar-link @IsActive("Reservations", "EmployeeCreate")">
                            <i class="fs-4 bi-person-plus me-2"></i> <span>Walk-In Booking</span>
                        </a>
                    </li>

                    @* Admin & Manager Only: Reports *@
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <li>
                            <a asp-controller="Reports" asp-action="Index" class="nav-link sidebar-link @IsActive("Reports", "Index")">
                                <i class="fs-4 bi-file-earmark-bar-graph me-2"></i> <span>Reports</span>
                            </a>
                        </li>
                    }
                </ul>

                @* Login / Logout Partial *@
                <div class="mt-auto px-3 pb-4">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>

        @* Main Content Area *@
        <main class="col-md-9 ms-sm-auto col-xl-10 px-md-4 py-4 d-flex flex-column">
            <div class="flex-grow-1">
                @* Global Status Banners *@
                @if (TempData["SuccessMessage"] is string successMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="bi bi-check-circle me-2"></i> @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] is string errorMessage)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i> @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>

            @* FIX 2: Removed the generic "footer" class to stop ASP.NET absolute positioning. Added text-center. *@
            <footer class="border-top text-muted py-3 mt-auto text-center">
                &copy; 2026 - RVPark - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
            </footer>
        </main>

    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>