@* Authentication navigation state *@
<ul class="navbar-nav">
    
    @* Bypass: Forced true for UI testing *@
    @if (true) 
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-circle-user me-1"></i> Testing Bypass
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="accountDropdown">
                
                @* Customer view link *@
                <li>
                    <a class="dropdown-item py-2" asp-controller="Reservations" asp-action="MyReservations">
                        <i class="fa-solid fa-tent me-2 text-muted"></i> Customer Dashboard
                    </a>
                </li>
                
                @* Admin view link *@
                <li>
                    <a class="dropdown-item py-2" asp-controller="Reports" asp-action="Index">
                        <i class="fa-solid fa-lock me-2 text-muted"></i> Admin Portal
                    </a>
                </li>
                
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item py-2 text-danger">Logout</button>
                    </form>
                </li>
            </ul>
        </li>
    }
</ul>